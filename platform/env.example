# Copie para platform/.env (NÃO commitar) e troque os placeholders por valores gerados por você.
# Sugestão: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=troque-por-uma-senha-forte
AOK_ADMIN_BOOTSTRAP_KEY=troque-por-uma-chave-longa-e-aleatoria
# Cookie de sessão só por HTTPS (padrão true). Use false apenas em teste local sem HTTPS.
AOK_COOKIE_SECURE=true
# Documentação interativa (/docs, /redoc, /openapi.json). Use false em produção online.
AOK_DOCS_ENABLED=true
# Cabeçalho Strict-Transport-Security (HSTS). Ative (true) apenas atrás de HTTPS obrigatório.
AOK_HSTS_ENABLED=false
# IPs ou CIDRs de proxies reversos confiáveis separados por vírgula para ler X-Forwarded-For.
# Vazio/comentado por padrão (não confia em X-Forwarded-For sem configuração explícita).
# AOK_TRUSTED_PROXIES=
